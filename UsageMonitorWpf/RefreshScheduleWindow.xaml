<Window x:Class="UsageMonitorWpf.RefreshScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UsageMonitorWpf.Converters"
        Title="{DynamicResource rf.title}"
        Icon="Assets/AppIcon.ico"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        TextElement.Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border Margin="18" Style="{StaticResource Card}" Padding="20">
        <StackPanel>
            <TextBlock Text="{DynamicResource rf.title}" FontSize="20" FontWeight="Bold" />
            <TextBlock Text="{DynamicResource rf.subtitle}" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{DynamicResource rf.nextRenew}" Style="{StaticResource Muted}" FontSize="13" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding NextRenewText}" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource rf.dlg.runTime}" Style="{StaticResource Section}" />
            <RadioButton GroupName="Mode" Content="{DynamicResource rf.dlg.atReset}" IsChecked="{Binding ModeAtReset}" />
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="Mode" Content="{DynamicResource rf.dlg.atTime}" IsChecked="{Binding ModeAtTime}" Margin="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding ModeAtTime}">
                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding Hour}" Width="64" ItemStringFormat="00" />
                    <TextBlock Text=":" Margin="6,0" VerticalAlignment="Center" FontWeight="Bold" />
                    <ComboBox ItemsSource="{Binding Minutes}" SelectedItem="{Binding Minute}" Width="64" ItemStringFormat="00" />
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="Mode" Content="{DynamicResource rf.dlg.afterReset}" IsChecked="{Binding ModeAfterReset}" Margin="0" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding DelayOptions}" SelectedValuePath="Value" SelectedValue="{Binding DelayMinutes}"
                          Width="170" HorizontalAlignment="Left" IsEnabled="{Binding ModeAfterReset}" />
            </Grid>

            <TextBlock Text="{DynamicResource rf.dlg.repeat}" Style="{StaticResource Section}" />
            <RadioButton GroupName="Repeat" Content="{DynamicResource rf.dlg.once}" IsChecked="{Binding RepeatOnce}" />
            <RadioButton GroupName="Repeat" Content="{DynamicResource rf.dlg.every}" IsChecked="{Binding RepeatEvery}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="Repeat" Content="{DynamicResource rf.dlg.window}" IsChecked="{Binding RepeatWindow}" Margin="0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" IsEnabled="{Binding RepeatWindow}">
                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding WindowStartHour}" Width="84" ItemStringFormat="00':00'" />
                    <TextBlock Text="~" Margin="6,0" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding Hours}" SelectedItem="{Binding WindowEndHour}" Width="84" ItemStringFormat="00':00'" />
                </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource rf.dlg.windowNote}" Style="{StaticResource Muted}" Margin="0,4,0,0"
                       Visibility="{Binding RepeatWindow, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{DynamicResource rf.dlg.costMode}" Style="{StaticResource Section}" />
            <RadioButton GroupName="Cost" Content="{DynamicResource rf.dlg.minimal}" IsChecked="{Binding CostMinimal}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="Cost" Content="{DynamicResource rf.dlg.custom}" IsChecked="{Binding CostCustom}" Margin="0" />
                <TextBox Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CostCustom}" ToolTip="haiku, sonnet, gpt-5-codex-mini …" />
            </Grid>

            <TextBlock Text="{DynamicResource rf.dlg.request}" Style="{StaticResource Section}" />
            <RadioButton GroupName="Prompt" Content="{DynamicResource rf.dlg.defaultPrompt}" IsChecked="{Binding PromptDefault}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton GroupName="Prompt" Content="{DynamicResource rf.dlg.customPrompt}" IsChecked="{Binding PromptCustom}" Margin="0" />
                <TextBox Grid.Column="1" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" IsEnabled="{Binding PromptCustom}" />
            </Grid>

            <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,18,0,0">
                <TextBlock Text="{Binding PreviewText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{DynamicResource rf.costNote}" Style="{StaticResource Muted}" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource rf.dlg.unschedule}" Command="{Binding UnscheduleCommand}" Margin="0,0,8,0" Foreground="#E0707A"
                        Visibility="{Binding IsScheduled, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{DynamicResource rf.dlg.close}" Command="{Binding CloseCommand}" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="{DynamicResource rf.dlg.schedule}" Command="{Binding ScheduleCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="90" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
