<Window x:Class="UsageMonitorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UsageMonitorWpf.Converters"
        xmlns:controls="clr-namespace:UsageMonitorWpf.Controls"
        Title="{DynamicResource ui.appName}"
        Icon="Assets/AppIcon.ico"
        Width="1100"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="Manual"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="{StaticResource AppFont}"
        TextElement.Foreground="{DynamicResource InkBrush}">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:TokenFreeBrushConverter x:Key="TokenFreeBrush" />
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="8"
                Padding="24"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{DynamicResource HeaderStartColor}" Offset="0" />
                    <GradientStop Color="{DynamicResource HeaderMiddleColor}" Offset="0.45" />
                    <GradientStop Color="{DynamicResource HeaderEndColor}" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/AppIcon.png" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppTitle}" Foreground="{DynamicResource HeaderBrush}" FontSize="28" FontWeight="Bold" />
                        <TextBlock Text="{Binding AppSubtitle}" Foreground="{DynamicResource HeaderBrush}" FontSize="13" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource ui.refreshing}" Foreground="{DynamicResource HeaderBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                               Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="{DynamicResource ui.refresh}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                    <Button Content="{DynamicResource ui.saveSnapshot}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource ui.liveChips}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="{DynamicResource ui.liveChipsDesc}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="8" Padding="9,5" Background="{DynamicResource CanvasBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding DisplayUsageLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                </Border>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding MiniProviders}" Margin="0,16,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="12,8" Margin="0,0,8,8" Background="{DynamicResource CanvasBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding AccentBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding ChipRemainingText}" FontWeight="Bold"
                                                           Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding ChipUsedText}" FontWeight="Bold"
                                                           Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <TextBlock Text="{Binding Countdown}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource ui.miniWidget}" FontSize="18" FontWeight="Bold" Margin="2,2,0,12" />
                    <ItemsControl ItemsSource="{Binding MiniProviders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding PrimaryMark}" Foreground="{DynamicResource AccentBrush}" FontSize="17" Margin="0,0,5,0" />
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="17" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding AccountName}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding RemainingLine}" Foreground="{Binding AccentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                                           Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding UsedLine}" Foreground="{Binding AccentBrush}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Right"
                                                           Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                                <TextBlock Text="{Binding SourceLine}" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,10,0,0"
                                                   Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}" />
                                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding LoginHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                            <Button Content="{Binding LoginButtonText}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,5"
                                                    IsEnabled="{Binding IsLoginPending, Converter={StaticResource InverseBool}}"
                                                    Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </StackPanel>

                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="50" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PrimaryLabel}" Foreground="{DynamicResource MutedBrush}" />
                                            <ProgressBar Grid.Column="1" Value="{Binding PrimaryPercent, Mode=OneWay}" Maximum="100" Foreground="{Binding AccentBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding PrimaryPercent, StringFormat={}{0}%}" TextAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>

                                        <!-- Weekly row; without a 5H window the long window is already the primary row above. -->
                                        <Grid Margin="0,11,0,0" Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                            <Grid Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="58" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="50" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding LongWindowLabel}" Foreground="{DynamicResource MutedBrush}" />
                                                <ProgressBar Grid.Column="1" Value="{Binding WeeklyUsagePercent, Mode=OneWay}" Maximum="100" />
                                                <TextBlock Grid.Column="2" Text="{Binding WeeklyUsagePercent, StringFormat={}{0}%}" TextAlignment="Right" FontWeight="SemiBold" />
                                            </Grid>
                                        </Grid>

                                        <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource ui.nextReset}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                                    <TextBlock Text="{Binding Countdown}" FontSize="18" FontWeight="Bold" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding ResetState}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource FlatCard}">
                        <StackPanel>
                            <TextBlock FontWeight="Bold"><Run Text="{DynamicResource ui.collectionLevel}" /><Run Text=": " /><Run Text="{Binding CollectionLevelLabel, Mode=OneWay}" /></TextBlock>
                            <TextBlock Text="{Binding FetchWarning}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex}">
                <TabItem Header="{DynamicResource ui.tab.overview}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,4">
                            <TextBlock Text="{DynamicResource ui.controlCenter}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource ui.controlCenterDesc}"
                                       Style="{StaticResource Muted}" Margin="0,5,0,18" />

                            <ItemsControl ItemsSource="{Binding DashboardProviders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="220" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PrimaryMark}" Foreground="{DynamicResource AccentBrush}" FontSize="20" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,4,0,14" />
                                                    <StackPanel Margin="0,0,0,14" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
                                                        <TextBlock Text="{Binding LoginHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                                        <Button Content="{Binding LoginButtonText}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,5"
                                                                IsEnabled="{Binding IsLoginPending, Converter={StaticResource InverseBool}}"
                                                                Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding PrimaryLongLabel}" FontWeight="SemiBold" />
                                                        <ProgressBar Grid.Column="1" Value="{Binding PrimaryPercent, Mode=OneWay}" Maximum="100" Foreground="{Binding AccentBrush}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding PrimaryPercent, StringFormat={}{0}%}" TextAlignment="Right" FontWeight="SemiBold" />
                                                    </Grid>
                                                    <Grid Margin="0,11,0,0" Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="96" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="56" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{DynamicResource ui.weekly}" FontWeight="SemiBold" />
                                                        <ProgressBar Grid.Column="1" Value="{Binding WeeklyUsagePercent, Mode=OneWay}" Maximum="100" />
                                                        <TextBlock Grid.Column="2" Text="{Binding WeeklyUsagePercent, StringFormat={}{0}%}" TextAlignment="Right" FontWeight="SemiBold" />
                                                    </Grid>

                                                    <ItemsControl ItemsSource="{Binding ModelBreakdown}" Margin="0,11,0,0"
                                                                  Visibility="{Binding HasModelBreakdown, Converter={StaticResource BoolToVisibility}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,0,0,7">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="96" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="56" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource MutedBrush}" />
                                                                    <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="5" />
                                                                    <TextBlock Grid.Column="2" Text="{Binding Percent, StringFormat={}{0}%}" TextAlignment="Right" Foreground="{DynamicResource MutedBrush}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <TextBlock Text="{Binding ExtraUsageText}" FontWeight="SemiBold" Margin="0,8,0,0"
                                                               Visibility="{Binding HasExtraUsage, Converter={StaticResource BoolToVisibility}}" />

                                                    <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,14,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="{DynamicResource ui.velocity}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding VelocityText}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                            <TextBlock Text="{DynamicResource ui.forecast}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                            <TextBlock Text="{Binding ForecastText}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <!-- Renewal: next renewable time, scheduled refresh, alert -->
                                                    <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,10,0,0"
                                                            Visibility="{Binding HasRenewal, Converter={StaticResource BoolToVisibility}}">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel>
                                                                    <TextBlock Text="{DynamicResource rf.nextRenew}" Style="{StaticResource Muted}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                        <TextBlock Text="{Binding NextRenewTime}" FontSize="18" FontWeight="Bold" />
                                                                        <TextBlock Text="{Binding NextRenewCountdown}" Style="{StaticResource Muted}" Margin="10,0,0,1" VerticalAlignment="Bottom" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{DynamicResource rf.title}" Style="{StaticResource Muted}" />
                                                                    <TextBlock Text="{Binding RefreshStatusText}" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                                <Button Content="{Binding NotifyButtonText}" Padding="10,4" MinHeight="28" Margin="0,0,8,0"
                                                                        Command="{Binding DataContext.ToggleNotifyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding NotifyOnReset}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource PanelBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="{Binding ScheduleButtonText}" Padding="10,4" MinHeight="28" Margin="0,0,8,0"
                                                                        Command="{Binding DataContext.OpenScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasRefreshSchedule}" Value="True">
                                                                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                                    <Setter Property="Foreground" Value="{DynamicResource PanelBrush}" />
                                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="{DynamicResource rf.retry}" Padding="10,4" MinHeight="28" Style="{StaticResource PrimaryButton}"
                                                                        Visibility="{Binding CanRetryRefresh, Converter={StaticResource BoolToVisibility}}"
                                                                        Command="{Binding DataContext.RetryRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <Border Grid.Column="2" CornerRadius="8" Padding="14" Background="{DynamicResource CanvasBrush}">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="9" Height="9" Fill="{Binding HealthBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding HealthLabel}" FontWeight="Bold" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding PlanLine}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                                        <TextBlock Text="{Binding SourceDisplayLine}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding LastSuccessText}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                        <TextBlock Text="{Binding WeeklyResetDisplay}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                                                        <Button Content="{DynamicResource ui.acc.manage}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="0,4" MinHeight="0" Margin="0,8,0,0"
                                                                Command="{Binding DataContext.OpenAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        <TextBlock Text="{DynamicResource ui.fieldSources}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                                        <TextBlock Text="{Binding FieldSourcesText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource ui.tab.history}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource ui.usageHistory}" Style="{StaticResource SectionTitle}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding HistoryChartModes}" SelectedValuePath="Value" SelectedValue="{Binding HistoryChartMode}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ComboBox Grid.Column="2" ItemsSource="{Binding HistoryRanges}" SelectedValuePath="Value" SelectedValue="{Binding HistoryRange}" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{Binding HistoryChartDescription}" Style="{StaticResource Muted}" Margin="0,5,0,0" />
                            <Border Style="{StaticResource Card}" Margin="0,14,0,14">
                                <StackPanel>
                                    <controls:HistoryChart Height="210"
                                                           Series="{Binding ChartSeries}"
                                                           Range="{Binding ChartRange}"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           GridBrush="{DynamicResource LineBrush}" />
                                    <ItemsControl ItemsSource="{Binding ChartSeries}" Margin="36,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                                    <Rectangle Width="14" Height="3" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="Fill" Value="{Binding Brush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Dashed}" Value="True">
                                                                        <Setter Property="Fill" Value="Transparent" />
                                                                        <Setter Property="Stroke" Value="{Binding Brush}" />
                                                                        <Setter Property="StrokeThickness" Value="2" />
                                                                        <Setter Property="StrokeDashArray" Value="2,1.4" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DashboardProviders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource FlatCard}" Margin="0,0,10,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" />
                                                <TextBlock Text="{DynamicResource ui.resetTimeline}" FontWeight="SemiBold" Margin="0,10,0,4" />
                                                <TextBlock Text="{Binding TimelineText}" Style="{StaticResource Mono}" />
                                                <TextBlock Text="{DynamicResource ui.resetHistory}" FontWeight="SemiBold" Margin="0,12,0,4" />
                                                <TextBlock Text="{Binding ResetHistoryText}" Style="{StaticResource Mono}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBox Text="{Binding HistoryText, Mode=OneWay}" Height="220" Margin="0,4,0,0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource ui.tab.accounts}">
                    <Grid Margin="4,18,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource ui.accounts}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource ui.accountsDesc}" Style="{StaticResource Muted}" Margin="0,5,0,16" />
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Account list: pick one to edit on the right -->
                            <Border Style="{StaticResource FlatCard}" Padding="8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="4,8,4,4">
                                        <Button Content="{DynamicResource ui.acc.addClaude}" Command="{Binding AddAccountCommand}" CommandParameter="claude" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" />
                                        <Button Content="{DynamicResource ui.acc.addCodex}" Command="{Binding AddAccountCommand}" CommandParameter="codex" Style="{StaticResource GhostButton}" Margin="0,4,0,0" />
                                        <Button Content="{DynamicResource ui.acc.addCopilot}" Command="{Binding AddAccountCommand}" CommandParameter="copilot" Style="{StaticResource GhostButton}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedAccount}"
                                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Margin" Value="0,0,0,4" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Row" CornerRadius="8" Padding="10,9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CanvasBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource CanvasBrush}" />
                                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Rectangle Width="4" RadiusX="2" RadiusY="2" Fill="{Binding SeriesBrush}" Margin="0,2,10,2" />
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding PrimaryMark}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" />
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding AccountName}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding HealthBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding ListStatus}" FontSize="12" Foreground="{DynamicResource MutedBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <!-- Details of the selected account; every change is saved immediately -->
                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <Border Style="{StaticResource Card}" DataContext="{Binding SelectedAccount}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" />
                                                <TextBlock Text="{DynamicResource ui.acc.autoSave}" Style="{StaticResource Muted}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{DynamicResource ui.acc.viewOverview}" Style="{StaticResource GhostButton}" VerticalAlignment="Top"
                                                    Command="{Binding DataContext.ShowInOverviewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid>

                                        <!-- Usage summary -->
                                        <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,16,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding PrimaryLabel}" Style="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding PrimaryPercent, StringFormat={}{0}%}" FontSize="20" FontWeight="Bold" Foreground="{Binding AccentBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="{DynamicResource ui.weekly}" Style="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding WeeklyUsagePercent, StringFormat={}{0}%}" FontSize="20" FontWeight="Bold" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="{DynamicResource ui.col.health}" Style="{StaticResource Muted}" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Ellipse Width="9" Height="9" Fill="{Binding HealthBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding HealthLabel}" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Login -->
                                        <TextBlock Text="{DynamicResource ui.acc.loginState}" FontWeight="SemiBold" Margin="0,18,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding LoginStateText}" />
                                                <TextBlock Text="{Binding LoginHint}" Style="{StaticResource Muted}" FontSize="12"
                                                           Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="{Binding LoginButtonText}" Style="{StaticResource PrimaryButton}"
                                                    IsEnabled="{Binding IsLoginPending, Converter={StaticResource InverseBool}}"
                                                    Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="1" Content="{DynamicResource ui.acc.relogin}"
                                                    Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}"
                                                    Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid>

                                        <!-- Name -->
                                        <TextBlock Text="{DynamicResource ui.acc.name}" FontWeight="SemiBold" Margin="0,18,0,6" />
                                        <TextBox Text="{Binding AccountName, UpdateSourceTrigger=LostFocus}" />

                                        <!-- Config folder -->
                                        <TextBlock Text="{DynamicResource ui.acc.folder}" FontWeight="SemiBold" Margin="0,18,0,6" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding ConfigDirectory, UpdateSourceTrigger=LostFocus}" />
                                            <Button Grid.Column="1" Content="{DynamicResource ui.acc.browse}" Margin="8,0,0,0"
                                                    Command="{Binding DataContext.BrowseFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <Button Grid.Column="2" Content="{DynamicResource ui.acc.useDefault}" Margin="6,0,0,0" Style="{StaticResource GhostButton}"
                                                    Command="{Binding DataContext.ClearFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        </Grid>
                                        <TextBlock Text="{Binding DefaultFolderHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" />

                                        <!-- GitHub login (Copilot keeps several logins in one folder) -->
                                        <StackPanel Visibility="{Binding HasLoginChoice, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{DynamicResource ui.acc.githubLogin}" FontWeight="SemiBold" Margin="0,18,0,6" />
                                            <ComboBox ItemsSource="{Binding LoginOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                      SelectedValue="{Binding GitHubLogin}" />
                                            <TextBlock Text="{DynamicResource ui.acc.githubLoginHint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Options -->
                                        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                            <CheckBox Content="{DynamicResource ui.acc.enabled}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                            <Button Content="{DynamicResource ui.acc.primary}" Margin="18,0,0,0"
                                                    Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                                                    Command="{Binding DataContext.SetPrimaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            <TextBlock Text="{DynamicResource ui.acc.isPrimary}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" Margin="18,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding IsPrimary, Converter={StaticResource BoolToVisibility}}" />
                                        </StackPanel>

                                        <!-- Display: hide from screens while keeping login and collection -->
                                        <TextBlock Text="{DynamicResource ui.acc.display}" FontWeight="SemiBold" Margin="0,18,0,8" />
                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding IsEnabled}">
                                            <CheckBox Content="{DynamicResource ui.acc.showMini}" IsChecked="{Binding ShowInMini}" />
                                            <CheckBox Content="{DynamicResource ui.acc.showDashboard}" IsChecked="{Binding ShowInDashboard}" Margin="22,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource ui.acc.displayNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                                   Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{DynamicResource ui.acc.monitorOffNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                                   Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                                        <!-- Remove -->
                                        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,20,0,14" />
                                        <Button Content="{DynamicResource ui.acc.remove}" HorizontalAlignment="Left" Foreground="#E0707A"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}"
                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                        <TextBlock Text="{DynamicResource ui.acc.defaultNote}" Style="{StaticResource Muted}" FontSize="12"
                                                   Visibility="{Binding IsDefaultAccount, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource ui.tab.snapshot}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,4">
                            <TextBlock Text="{DynamicResource ui.manualSnapshot}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource ui.manualSnapshotDesc}"
                                       Style="{StaticResource Muted}" Margin="0,5,0,18" />
                            <ItemsControl ItemsSource="{Binding DashboardProviders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="130" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.ColumnSpan="4" Text="{Binding Title}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16" />
                                                <TextBlock Grid.Row="1" Text="{DynamicResource ui.plan}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Plan, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,10" />
                                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{DynamicResource ui.source}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding Source, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                                <TextBlock Grid.Row="2" Text="{DynamicResource ui.5hUsage}" VerticalAlignment="Center" Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SessionUsagePercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,14,10" Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LongUsageLabel}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding WeeklyUsagePercent, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
                                                <TextBlock Grid.Row="3" Text="{DynamicResource ui.5hReset}" VerticalAlignment="Center" Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SessionResetText, UpdateSourceTrigger=LostFocus}" Margin="0,0,14,10" Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding LongResetLabel}" VerticalAlignment="Center" />
                                                <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding WeeklyResetText, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" />
                                                <TextBlock Grid.Row="4" Text="{DynamicResource ui.confidence}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Row="4" Grid.Column="1" Text="{Binding Confidence, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,0,14,0">
                                                    <ComboBoxItem Content="High" />
                                                    <ComboBoxItem Content="Medium" />
                                                    <ComboBoxItem Content="Low" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{DynamicResource ui.saveManualSnapshot}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource ui.tab.diagnostics}">
                    <Grid Margin="4,18,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource ui.collectorDiagnostics}" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                        <TextBox Grid.Row="1" Text="{Binding DiagnosticsText, Mode=OneWay}" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource ui.tab.refresh}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,4">
                            <TextBlock Text="{DynamicResource rf.title}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource rf.subtitle}" Style="{StaticResource Muted}" Margin="0,5,0,4" />
                            <TextBlock Text="{DynamicResource rf.explain}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,16" />

                            <!-- Schedules -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource rf.set.list}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding ActiveProviders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,0,0,8"
                                                        Visibility="{Binding HasSessionWindow, Converter={StaticResource BoolToVisibility}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Rectangle Width="4" Height="16" RadiusX="2" RadiusY="2" Fill="{Binding SeriesBrush}" Margin="0,0,8,0" />
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="12,6,0,0">
                                                                <TextBlock Text="{DynamicResource rf.nextRenew}" Style="{StaticResource Muted}" Margin="0,0,6,0" />
                                                                <TextBlock Text="{Binding NextRenewTime}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding NextRenewCountdown}" Style="{StaticResource Muted}" Margin="8,0,0,0" />
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding RefreshStatusText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="12,4,0,0" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding ScheduleSummary}" Style="{StaticResource Muted}" FontSize="12" Margin="12,2,0,0"
                                                                       Visibility="{Binding HasRefreshSchedule, Converter={StaticResource BoolToVisibility}}" />
                                                            <CheckBox Content="{DynamicResource rf.set.alertOnReset}" IsChecked="{Binding NotifyOnReset}" Margin="12,8,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                            <Button Content="{Binding ScheduleButtonText}" Margin="0,0,0,6" IsEnabled="{Binding HasUsage}"
                                                                    Command="{Binding DataContext.OpenScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasRefreshSchedule}" Value="True">
                                                                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                                                <Setter Property="Foreground" Value="{DynamicResource PanelBrush}" />
                                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                            </Button>
                                                            <Button Content="{DynamicResource rf.cancel}" Style="{StaticResource GhostButton}"
                                                                    Visibility="{Binding HasRefreshSchedule, Converter={StaticResource BoolToVisibility}}"
                                                                    Command="{Binding DataContext.CancelScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Content="{DynamicResource rf.retry}" Style="{StaticResource PrimaryButton}"
                                                                    Visibility="{Binding CanRetryRefresh, Converter={StaticResource BoolToVisibility}}"
                                                                    Command="{Binding DataContext.RetryRefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{DynamicResource rf.costNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Alerts / retry / missed policy -->
                            <Border Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource rf.set.preNotify}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="160" HorizontalAlignment="Left" ItemsSource="{Binding PreNotifyOptions}" SelectedValuePath="Value" SelectedValue="{Binding PreNotifyMinutes}" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="1" Text="{DynamicResource rf.set.retry}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                        <CheckBox Content="{DynamicResource rf.set.retryUse}" IsChecked="{Binding RetryEnabled}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                        <TextBlock Text="{DynamicResource rf.set.interval}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox Width="90" ItemsSource="{Binding RetryIntervalOptions}" SelectedValuePath="Value" SelectedValue="{Binding RetryIntervalMinutes}" IsEnabled="{Binding RetryEnabled}" Margin="0,0,14,0" />
                                        <TextBlock Text="{DynamicResource rf.set.max}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <ComboBox Width="80" ItemsSource="{Binding RetryMaxOptions}" SelectedValuePath="Value" SelectedValue="{Binding RetryMax}" IsEnabled="{Binding RetryEnabled}" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="{DynamicResource rf.set.missed}" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,0,10,0" />
                                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,6">
                                        <RadioButton GroupName="Missed" Content="{DynamicResource rf.set.missed.RunOnWake}" IsChecked="{Binding MissedRunOnWake}" Margin="0,0,0,6" />
                                        <RadioButton GroupName="Missed" Content="{DynamicResource rf.set.missed.WaitNext}" IsChecked="{Binding MissedWaitNext}" Margin="0,0,0,6" />
                                        <RadioButton GroupName="Missed" Content="{DynamicResource rf.set.missed.Skip}" IsChecked="{Binding MissedSkip}" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource rf.set.missedNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,10" />

                                    <TextBlock Grid.Row="4" Text="{DynamicResource rf.set.cli}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource rf.set.cliText}" Style="{StaticResource Mono}" FontSize="11" TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!-- Log -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource rf.set.log}" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" />
                                    <TextBox Text="{Binding RefreshLogText, Mode=OneWay}" Height="180" FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{DynamicResource ui.tab.settings}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,18,4,4">
                            <TextBlock Text="{DynamicResource ui.settings}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="{DynamicResource ui.settingsDesc}"
                                       Style="{StaticResource Muted}" Margin="0,5,0,18" />
                            <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="280" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{DynamicResource ui.runAtStartup}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <CheckBox Grid.Column="1" IsChecked="{Binding RunAtStartup}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{DynamicResource ui.runAtStartupNote}" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14" />
                                    <TextBlock Grid.Row="2" Text="{DynamicResource ui.collectionLevel}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CollectionLevels}" SelectedValuePath="Value" SelectedValue="{Binding CollectionLevel}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="3" Text="{DynamicResource ui.refreshInterval}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding RefreshIntervals}" SelectedValuePath="Value" SelectedValue="{Binding RefreshSeconds}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="4" Text="{DynamicResource ui.favorite}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ProviderIds}" SelectedValuePath="Value" SelectedValue="{Binding FavoriteProvider}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="5" Text="{DynamicResource ui.widgetMode}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding WidgetModes}" SelectedValuePath="Value" SelectedValue="{Binding WidgetMode}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="6" Text="{DynamicResource ui.windowVersion}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding WindowVersions}" SelectedValuePath="Value" SelectedValue="{Binding WindowVersion}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="7" Text="{DynamicResource ui.displayUsageAs}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding DisplayOptions}" SelectedValuePath="Value" SelectedValue="{Binding DisplayUsageAs}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="8" Text="{DynamicResource ui.language}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="8" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedValuePath="Value" SelectedValue="{Binding Language}" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="9" Text="{DynamicResource ui.theme}" VerticalAlignment="Center" />
                                    <ComboBox Grid.Row="9" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedValuePath="Value" SelectedValue="{Binding Theme}" Margin="0,0,0,10" />
                                    <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Margin="0,0,0,12"
                                                Visibility="{Binding IsCustomTheme, Converter={StaticResource BoolToVisibility}}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{DynamicResource ui.customThemeDesc}" Style="{StaticResource Muted}" FontSize="12"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                            <!-- Fixed colors on purpose: this button previews live custom-theme edits everywhere else via
                                                 DynamicResource, so if it used theme brushes too, a bad color combo could hide the one
                                                 control that undoes it. -->
                                            <Button Grid.Column="1" Content="{DynamicResource ui.resetCustomTheme}" Command="{Binding ResetCustomThemeCommand}"
                                                    Background="#FFFFFF" Foreground="#15191D" BorderBrush="#15191D" />
                                        </Grid>
                                        <UniformGrid Columns="2">
                                            <StackPanel Margin="0,0,12,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomInk, Mode=TwoWay}" PreviewResourceKey="InkBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customInk}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomMuted, Mode=TwoWay}" PreviewResourceKey="MutedBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customMuted}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomAccent, Mode=TwoWay}" PreviewResourceKey="AccentBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customAccent}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomPanel, Mode=TwoWay}" PreviewResourceKey="PanelBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customPanel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomCanvas, Mode=TwoWay}" PreviewResourceKey="CanvasBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customCanvas}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomLine, Mode=TwoWay}" PreviewResourceKey="LineBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customLine}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomHeader, Mode=TwoWay}" PreviewResourceKey="HeaderBrush" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customHeader}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomHeaderStart, Mode=TwoWay}" PreviewResourceKey="HeaderStartColor" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customHeaderStart}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0" Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomHeaderMiddle, Mode=TwoWay}" PreviewResourceKey="HeaderMiddleColor" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customHeaderMiddle}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <controls:ColorPickerButton Color="{Binding CustomHeaderEnd, Mode=TwoWay}" PreviewResourceKey="HeaderEndColor" Margin="0,0,10,0" />
                                                <TextBlock Text="{DynamicResource ui.customHeaderEnd}" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{DynamicResource ui.presets}" Style="{StaticResource Muted}" FontSize="12" Margin="0,12,0,6" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding PresetName, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{DynamicResource ui.presetNamePlaceholder}" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="{DynamicResource ui.savePreset}" Command="{Binding SaveThemePresetCommand}" Style="{StaticResource GhostButton}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding CustomThemePresets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" />
                                                        <Button Grid.Column="1"
                                                                Content="{DynamicResource ui.applyPreset}"
                                                                Command="{Binding DataContext.ApplyThemePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" />
                                                        <Button Grid.Column="2"
                                                                Content="{DynamicResource ui.deletePreset}"
                                                                Command="{Binding DataContext.DeleteThemePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource GhostButton}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <TextBlock Grid.Row="11" Text="{DynamicResource ui.notifications}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="11" Grid.Column="1" IsChecked="{Binding NotificationsEnabled}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="12" Text="{DynamicResource ui.thresholds}" VerticalAlignment="Center" />
                                    <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding ThresholdsText, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,10" ToolTip="{DynamicResource ui.thresholdsTip}" />
                                    <TextBlock Grid.Row="13" Text="{DynamicResource ui.taskbarChips}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="13" Grid.Column="1" IsChecked="{Binding ShowTaskbarChips}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="14" Text="{DynamicResource ui.alwaysOnTop}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="14" Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="15" Text="{DynamicResource ui.chipsOpacity}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="15" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding ChipsOpacity}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding ChipsOpacityText}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="16" Text="{DynamicResource ui.widgetOpacity}" VerticalAlignment="Center" />
                                    <Grid Grid.Row="16" Grid.Column="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Value="{Binding WidgetOpacity}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding WidgetOpacityText}" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Grid.Row="17" Text="{DynamicResource ui.hoverOpaque}" VerticalAlignment="Center" />
                                    <CheckBox Grid.Row="17" Grid.Column="1" IsChecked="{Binding HoverOpaque}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="18" Text="{DynamicResource ui.internalVersion}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="18" Grid.Column="1" Text="{Binding InternalVersion}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="19" Text="{DynamicResource ui.stateSchema}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="19" Grid.Column="1" Text="{Binding StateSchemaVersion}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,0,10" />
                                    <TextBlock Grid.Row="20" Grid.ColumnSpan="2" Style="{StaticResource Muted}"><Run Text="{DynamicResource ui.dataDirectory}" /><Run Text="{Binding DataDirectory, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Grid.Row="21" Grid.ColumnSpan="2" Text="{Binding FetchWarning}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" MaxWidth="620" HorizontalAlignment="Left">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/AppIcon.png" Width="56" Height="56" VerticalAlignment="Top"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource ui.about}" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource ui.appLegalName}" FontSize="22" FontWeight="Bold" Margin="0,2,0,0" />
                                        <TextBlock Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0">
                                            <Run Text="v" /><Run Text="{Binding InternalVersion, Mode=OneWay}" />
                                        </TextBlock>
                                        <StackPanel Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{DynamicResource ui.checkForUpdate}" Command="{Binding CheckForUpdateCommand}"
                                                        IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InverseBool}}" />
                                                <TextBlock Text="{Binding UpdateStatusText}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                                                <TextBlock Text="{Binding UpdateAvailableText}" FontWeight="SemiBold" />
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button Content="{DynamicResource ui.downloadUpdate}" Command="{Binding DownloadUpdateCommand}" Margin="0,0,8,8"
                                                            IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource InverseBool}}" />
                                                    <Button Content="{DynamicResource ui.releaseNotes}" Command="{Binding OpenReleaseNotesCommand}" Margin="0,0,8,8" />
                                                </WrapPanel>
                                                <ProgressBar Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}"
                                                             Minimum="0" Maximum="1" Value="{Binding UpdateDownloadProgress, Mode=OneWay}" Height="6" Margin="0,0,0,4" />
                                                <TextBlock Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding UpdateDownloadProgressText}" Style="{StaticResource Muted}" FontSize="12" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource ui.aboutDesc}" Style="{StaticResource Muted}" Margin="0,10,0,0" />
                                        <TextBlock Text="{DynamicResource ui.copyright}" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                                        <TextBlock Text="{DynamicResource ui.licenseSummary}" Style="{StaticResource Muted}" Margin="0,12,0,0" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="{DynamicResource ui.license}" Command="{Binding OpenLicenseCommand}" Margin="0,0,8,8" />
                                            <Button Content="{DynamicResource ui.openSourceLicenses}" Command="{Binding OpenOpenSourceLicensesCommand}" Margin="0,0,8,8" />
                                            <Button Content="{DynamicResource ui.githubRepository}" Command="{Binding OpenRepositoryCommand}" Margin="0,0,8,8" />
                                            <Button Content="{DynamicResource ui.reportIssue}" Command="{Binding ReportIssueCommand}" Margin="0,0,8,8" />
                                        </WrapPanel>
                                        <Border CornerRadius="8" Padding="12" Background="{DynamicResource CanvasBrush}" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource ui.disclaimer}" Style="{StaticResource Muted}" />
                                                <TextBlock Text="{DynamicResource ui.trademarkNotice}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
