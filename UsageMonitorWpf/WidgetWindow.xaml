<Window x:Class="UsageMonitorWpf.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:UsageMonitorWpf.Converters"
        Title="Usage Widget"
        Width="330"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="{Binding AlwaysOnTop}"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        TextElement.Foreground="{DynamicResource InkBrush}"
        AllowsTransparency="True">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
    </Window.Resources>

    <Border CornerRadius="8"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            Padding="14"
            MouseLeftButtonDown="Widget_MouseLeftButtonDown"
            MouseMove="Widget_MouseMove"
            MouseLeftButtonUp="Widget_MouseLeftButtonUp">
        <Border.Effect>
            <DropShadowEffect Color="#243039" BlurRadius="34" ShadowDepth="10" Opacity="0.22" />
        </Border.Effect>
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{DynamicResource ui.openDashboard}" Click="Open_Click" />
                <MenuItem Header="{DynamicResource ui.refresh}" Command="{Binding RefreshCommand}" />
                <Separator />
                <MenuItem IsHitTestVisible="True" StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="190">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding WidgetOpacityText}" />
                                <TextBlock Text="{DynamicResource ui.opacity}" />
                            </DockPanel>
                            <Slider Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    Value="{Binding WidgetOpacity}" Margin="0,4,0,0" />
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <MenuItem Header="{DynamicResource ui.hoverOpaque}" IsCheckable="True" IsChecked="{Binding HoverOpaque}" />
                <Separator />
                <MenuItem Header="{DynamicResource ui.hide}" Click="Hide_Click" />
                <MenuItem Header="{DynamicResource ui.exit}" Click="Exit_Click" />
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/AppIcon.png" Width="30" Height="30" Margin="0,0,9,0" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource ui.aiUsage}" FontWeight="Bold" FontSize="15" />
                        <TextBlock Text="{Binding DisplayUsageLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="FoldButton" Padding="8,4" MinHeight="26" MinWidth="30" Click="Fold_Click" Margin="0,0,6,0" FontSize="11" />
                    <Button Content="{DynamicResource ui.details}" Padding="10,4" MinHeight="26" Click="Open_Click" Margin="0,0,6,0" />
                    <Button Content="×" Padding="9,4" MinHeight="26" Click="Hide_Click" ToolTip="{DynamicResource ui.hide}" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding MiniProviders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8"
                                Background="{DynamicResource CanvasBrush}"
                                Padding="12"
                                Margin="0,0,0,9">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PrimaryMark}" Foreground="{DynamicResource AccentBrush}" Margin="0,0,4,0" />
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                        </StackPanel>
                                        <!-- Time until the 5H window resets, shown in every widget mode. -->
                                        <TextBlock Text="{Binding CountdownLine}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,2,0,0"
                                                   Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding RefreshStatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,2,0,0"
                                                   Visibility="{Binding HasRefreshSchedule, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RemainingLine}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding AccentBrush}"
                                                   Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding UsedLine}"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding AccentBrush}"
                                                   Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}" />
                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding LoginHint}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                    <Button Content="{Binding LoginButtonText}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="12,5"
                                            IsEnabled="{Binding IsLoginPending, Converter={StaticResource InverseBool}}"
                                            Command="{Binding DataContext.LoginCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                </StackPanel>
                                <ProgressBar Value="{Binding SessionUsagePercent, Mode=OneWay}" Maximum="100" Foreground="{Binding AccentBrush}" Margin="0,10,0,0"
                                             Visibility="{Binding DataContext.IsCompact, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding DataContext.IsDetailed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding WeeklyRemainingLine}" FontSize="12"
                                               Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding WeeklyUsedLine}" FontSize="12"
                                               Visibility="{Binding DataContext.ShowRemaining, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                                    <ProgressBar Value="{Binding WeeklyUsagePercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,4" />
                                    <TextBlock Text="{Binding SourceLine}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding ForecastText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
