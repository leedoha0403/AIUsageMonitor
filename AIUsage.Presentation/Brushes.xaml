<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Default theme colors. A shell that themes the app (or a Host) overrides these keys at Application level. -->
        <SolidColorBrush x:Key="InkBrush" Color="#15191D" />
        <SolidColorBrush x:Key="MutedBrush" Color="#66717C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1F8A70" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F6F8F7" />
        <SolidColorBrush x:Key="LineBrush" Color="#2415191D" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#15191D" />
        <Color x:Key="HeaderStartColor">#0B1418</Color>
        <Color x:Key="HeaderMiddleColor">#0F2A2B</Color>
        <Color x:Key="HeaderEndColor">#17806B</Color>
</ResourceDictionary>
