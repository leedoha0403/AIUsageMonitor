<UserControl x:Class="AIUsage.Presentation.Views.UsageDashboardHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIUsage.Presentation.Converters"
             FontFamily="{DynamicResource AppFont}"
             TextElement.Foreground="{DynamicResource InkBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AIUsage.Presentation;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The dashboard banner, shared by the standalone window and the Host's detail window. -->
    <Border CornerRadius="8" Padding="24">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{DynamicResource HeaderStartColor}" Offset="0" />
                <GradientStop Color="{DynamicResource HeaderMiddleColor}" Offset="0.45" />
                <GradientStop Color="{DynamicResource HeaderEndColor}" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/AIUsage.Presentation;component/Assets/AppIcon.png" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding AppTitle}" Foreground="{DynamicResource HeaderBrush}" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="{Binding AppSubtitle}" Foreground="{DynamicResource HeaderBrush}" FontSize="13" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource ui.refreshing}" Foreground="{DynamicResource HeaderBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                           Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{DynamicResource ui.refresh}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" />
                <Button Content="{DynamicResource ui.saveSnapshot}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
